{
  "name": "nostr-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src e2e playwright.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "deploy": "cf deploy",
    "deploy:dry-run": "cf deploy --dry-run"
  },
  "dependencies": {
    "@digital-go-jp/tailwind-theme-plugin": "1.0.1",
    "nostr-tools": "2.25.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "cf": "0.15.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.10",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@12.10.1"
}
